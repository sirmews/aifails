{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ugh-llms",
  "account_id": "b1eff84e032ba5f31c971508e291ff16",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "aifails.wtf",
      "custom_domain": true
    },
    {
      "pattern": "www.aifails.wtf",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ugh_llms_db",
      "database_id": "44462d16-1cd1-421f-8cda-fd6314f8efc1",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "a384593cfe12477e99ac05747c395e33"
    }
  ],
  "ratelimits": [
    {
      "name": "CONFESSION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SOLIDARITY_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEZJ2e4Jgj2PjMhr",
    "ENVIRONMENT": "production"
  }
}
